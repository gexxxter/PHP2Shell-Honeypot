# copy to .env and adjust
SHOP_URL=https://your-domain.example
DB_PASS=change-me-shop-db
# TLS (optional; run scripts/get-cert.sh first). Directory holding fullchain.pem and privkey.pem:
CERT_DIR=./certs
# Optional alerts, see vector/alerts/slack.yaml.example
SLACK_WEBHOOK_URL=

# Live dashboard login (mandatory: the dashboard refuses to start without it). deploy.sh reuses T-Pot's web login.
# Use single quotes if the password contains special characters; it cannot contain a single quote or a dollar sign.
LIVE_USER=admin
LIVE_PASSWORD=change-me-please
